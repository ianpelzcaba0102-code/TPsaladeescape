@model sala_de_escape.Models.GameRoom
@{
    ViewData["Title"] = Model.Title;
}

<div class="escape-shell">
    <div class="card game-card shadow-lg">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-dark">@ViewBag.Progress</span>
                <span class="text-muted">Jugador: @ViewBag.PlayerName</span>
            </div>

            <h2 class="mb-3">@Model.Title</h2>
            <p class="lead">@Model.Description</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div class="alert alert-light border">
                <strong>Desafío:</strong>
                <p class="mb-0">@Model.Prompt</p>
            </div>

            <div class="alert alert-secondary">
                <strong>Pista:</strong>
                <span>@Model.Hint</span>
            </div>

            <form asp-action="SubmitAnswer" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="answer" class="form-label fw-semibold">Respuesta</label>
                    <input id="answer" name="answer" class="form-control form-control-lg" placeholder="Ingresá la respuesta" required />
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Enviar</button>
            </form>
        </div>
    </div>
</div>
